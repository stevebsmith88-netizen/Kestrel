# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard > Project Settings > API). Never commit .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The two values below are for sign in. They are safe to be public: the address is
# the same Project URL, and the publishable key is the one that starts sb_publishable_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Email sent by the website itself (application alerts and updates). Create a sending key in Resend.
# Leave RESEND_API_KEY empty and the site simply skips these emails.
RESEND_API_KEY=your-resend-sending-key
EMAIL_FROM=Kestrel Eye Care Jobs <hello@mail.eyecarejobs.ca>
# The ad builder (writes a draft job ad). Create a key in the Anthropic console. Leave empty and the button is hidden.
ANTHROPIC_API_KEY=your-anthropic-key
# A long random password that protects the daily housekeeping job. Vercel sends it automatically.
CRON_SECRET=a-long-random-string

# Where Kestrel emails you about problems and reported jobs (your own inbox).
ADMIN_ALERT_EMAIL=you@example.com

# The bot check on the waitlist, sign up, password reset and report forms (Cloudflare Turnstile). Both are needed. Leave them empty to switch it off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Where replies to the site's automatic emails go. Use a real inbox, such as hello@eyecarejobs.ca. Leave empty to send no reply address.
EMAIL_REPLY_TO=hello@eyecarejobs.ca
