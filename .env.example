# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Every setting the code reads is explained in docs/settings.md, with the value it should have in the live and demo
# Vercel projects. Values below that say "your-..." are placeholders for secrets: put the real ones in .env.local and
# in Vercel only, never here.

# ---- Keys and addresses ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# From the Supabase dashboard, Project Settings, API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The two values below are for sign in. They are safe to be public: the address is
# the same Project URL, and the publishable key is the one that starts sb_publishable_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Email sent by the website itself. Leave RESEND_API_KEY empty and the site simply skips these emails.
RESEND_API_KEY=your-resend-sending-key
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret
EMAIL_FROM=Kestrel Eye Care Jobs <hello@mail.eyecarejobs.ca>
# Where replies to the site's automatic emails go. Use a real inbox.
EMAIL_REPLY_TO=support@eyecarejobs.ca
# Where Kestrel emails you about problems and reported jobs, and an optional second inbox.
ADMIN_ALERT_EMAIL=you@example.com
ADMIN_BACKUP_EMAIL=
# A long random password that protects the daily housekeeping job. Vercel sends it automatically.
CRON_SECRET=a-long-random-string
# The ad builder, careers page reader and province search. Leave empty and those buttons are hidden.
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_WORKSPACE_ID=
# Stripe, test mode until prices are switched on (docs/plans/stripe-plan.md). Admin, Payments checks both.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# The bot check (Cloudflare Turnstile). Both are needed. Leave them empty to switch it off on your own computer.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
INDEXNOW_KEY=

# ---- On and off switches (leave empty unless docs/settings.md says otherwise) ----
DEMO_MODE=
MAINTENANCE_MODE=
CLINIC_SIGNUP=
CLINIC_INVITE_CODE=
ENABLE_GOOGLE_SIGNIN=
ENABLE_ONBOARDING_EMAILS=
ENABLE_SEEDING=
ENABLE_OUTREACH=
OUTREACH_DAILY_LIMIT=
ENABLE_COMPARE=
ENABLE_FIND_YOUR_FIT=
ENABLE_HOME_BLOG=
PRELAUNCH_HOME=
LAUNCH_HOME=
DAILY_EMAIL_BUDGET=
AD_BUILDER_MODEL=
PAGE_READER_MODEL=

# Stripe, test mode first (docs/plans/stripe-plan.md). Not read by the code yet.
STRIPE_SECRET_KEY=sk_test_your-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
